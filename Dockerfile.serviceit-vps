# Independent corporate VPS; NEVER runs a writer on container startup.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements.txt requirements-vps.txt /app/
RUN python -m pip install --no-cache-dir -r requirements-vps.txt
COPY leadpilot /app/leadpilot
# Independent project STOP rules; empty by default. No credentials are copied.
COPY config/serviceit_own_signal_stop.json /app/config/serviceit_own_signal_stop.json
COPY certificates /app/certificates
# Release archives are unpacked on the VPS under umask 077, so Docker COPY
# preserves 0600 source modes. Regrant READ/TRAVERSE only to public application
# code and public CA certificates INSIDE the image, not on the VPS host.
# Mounted secrets under /run/secrets are NEVER copied or chmodded.
RUN chmod -R a+rX /app/leadpilot /app/config /app/certificates
RUN groupadd --gid 10001 serviceit && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin serviceit
USER 10001:10001
# Host networking makes local PostgreSQL reachable at 127.0.0.1:5432.
# ASGI ingress listens ONLY on host loopback 127.0.0.1:18780.
CMD ["python", "-m", "uvicorn", "leadpilot.serviceit_vps_ingress:app", "--host", "127.0.0.1", "--port", "18780", "--workers", "1", "--no-access-log"]
