# Only the authenticated event receiver. Never runs a CRM writer or AI worker.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY leadpilot /app/leadpilot

# Docker named volume inherits this writable directory on first use.
RUN groupadd --gid 10001 serviceit \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin serviceit \
 && mkdir -p /var/lib/serviceit \
 && chown -R serviceit:serviceit /app /var/lib/serviceit
USER 10001:10001

EXPOSE 8000
CMD ["python","-m","uvicorn","leadpilot.serviceit_bitrix_event_receiver:app","--host","0.0.0.0","--port","8000","--workers","1","--no-access-log"]
