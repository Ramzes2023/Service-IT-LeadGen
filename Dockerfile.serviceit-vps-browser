# OPTIONAL public website browser research runner. Not in the CRM worker image.
# Pin package and OS/browser binary release to exactly the same version.
# Official Playwright image is NOT sufficient isolation for untrusted sites;
# do not deploy until container egress firewall / seccomp userns policies have
# been reviewed by the owner. Never mount Bitrix/PG/RouterAI/GitHub secrets.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    XDG_CONFIG_HOME=/tmp XDG_CACHE_HOME=/tmp
WORKDIR /app
RUN python -m pip install --no-cache-dir "playwright==1.64.1" "httpx>=0.27,<1"
COPY leadpilot /app/leadpilot
RUN chmod -R a+rX /app/leadpilot
# The official image includes an ordinary unprivileged pwuser.
USER pwuser
CMD ["python", "-m", "leadpilot.serviceit_vps_public_browser", "--selfcheck"]
