# Non-secret configuration ONLY. Copy outside the repository.
SERVICEIT_VPS_SECRETS_DIR=/etc/serviceit/secrets
SERVICEIT_VPS_INTAKE_ENABLED=NO
SERVICEIT_VPS_WRITER_MODE=READONLY
SERVICEIT_VPS_CUTOVER_AUTHORIZED=NO
SERVICEIT_VPS_OLD_GH_WRITERS_DISABLED_ACK=NO
SERVICEIT_VPS_POLL_ENABLED=NO
# Leave empty until an exact approved, verified old-writer shutdown.
SERVICEIT_VPS_NATIVE_ACTIVATION_UTC=
SERVICEIT_AI_PROVIDER=routerai
SERVICEIT_WORKER_MODEL_PRIVACY_APPROVED=NO
SERVICEIT_ROUTERAI_PRIVACY_APPROVED=NO
SERVICEIT_PRELIMINARY_PUBLIC_HOSTS=
SERVICEIT_PUBLIC_RESEARCH_COMPANY_HOSTS=
# Native auxiliary opt-ins; all OFF until real cutover/readback proof.
SERVICEIT_VPS_OWN_STOP_ENABLED=NO
SERVICEIT_VPS_CRM_DUPLICATE_ENABLED=NO
SERVICEIT_VPS_KANBAN_TITLE_ENABLED=NO
SERVICEIT_VPS_MANAGER_TASK_ENABLED=NO
SERVICEIT_STAGE3_FALLBACK_APPROVED=NO
SERVICEIT_STAGE3_FALLBACK_MANAGER_ID=
SERVICEIT_VPS_FNS_CRM_RESULT_ENABLED=NO
# Enable either provisional OR free-MSP internal score, never both.
SERVICEIT_VPS_PROVISIONAL_SCORE_ENABLED=NO
SERVICEIT_VPS_FREE_MSP_SCORE_ENABLED=NO
# Official MSP download requires explicit profile, dedicated disk, owner opt-in.
SERVICEIT_VPS_FNS_MSP_ENABLED=NO
SERVICEIT_VPS_FNS_SCRATCH_DIR=/var/lib/serviceit/fns-scratch
# Human-confirmed call results and internal finance tasks, both disabled.
SERVICEIT_VPS_POSTCALL_ENABLED=NO
SERVICEIT_VPS_FINANCE_ENABLED=NO
