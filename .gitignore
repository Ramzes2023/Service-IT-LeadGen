# Never commit API credentials, local stores, source response snapshots or private data
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/
local_config/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local operational data (including WAL/SHM)
data/**
!data/.gitkeep
exports/**
!exports/.gitkeep
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.log
*.jsonl

# Local editor/system artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
